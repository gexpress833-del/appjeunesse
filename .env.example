# ============================================================================
# Configuration Supabase
# ============================================================================
# Créez un projet sur https://supabase.com et copiez ces valeurs depuis le dashboard

# Supabase Project URL (disponible dans Settings → API → Project URL)
SUPABASE_URL=https://votre-projet.supabase.co

# Supabase Anon Key (disponible dans Settings → API → anon public key)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Configuration Cloudinary (optionnel - pour le stockage des images)
# ============================================================================
# Créez un compte sur https://cloudinary.com et configurez un upload preset unsigned

# Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=votre-cloud-name

# Cloudinary Upload Preset (doit être "unsigned" pour l'upload depuis le frontend)
CLOUDINARY_UPLOAD_PRESET=unsigned

# ============================================================================
# Instructions de configuration
# ============================================================================
# 1. Ouvrez supabase-config.html dans votre navigateur
# 2. Entrez les valeurs ci-dessus
# 3. Sauvegardez la configuration
# 4. La configuration sera stockée dans localStorage du navigateur
#
# Pour le développement en production, vous pouvez aussi définir ces variables
# dans un fichier .env local (non inclus dans git) ou les passer directement
# dans le code de configuration.
